# Front end (Next.js). `npx convex dev` writes this to .env.local for you.
NEXT_PUBLIC_CONVEX_URL=

# Backend (Convex). Set these with `npx convex env set NAME value`, not here.
# RESEND_API_KEY=   without it, emails are printed to the Convex logs instead of sent
# EMAIL_FROM=       e.g. "Incrementic Decisions <decisions@yourdomain.com>"
# APP_URL=          public URL of the front end, used for client links in emails
# ANTHROPIC_API_KEY= for AI drafting from captured text; without it, drivers write decisions by hand
